<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cyber_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Generator Alias"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Email dasar"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/spBase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Nama situs"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etSite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="tokopedia"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/cm_hint" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="URL situs (opsional)"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etSiteUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://…"
            android:inputType="textUri"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/cm_hint" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Pola alias"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <RadioGroup
            android:id="@+id/rgPattern"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton android:id="@+id/rbSite" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="nama situs" android:textColor="@color/text_primary" android:checked="true" />
            <RadioButton android:id="@+id/rbRandom" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="situs + 4 huruf acak" android:textColor="@color/text_primary" />
            <RadioButton android:id="@+id/rbDate" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="situs + tanggal (yyyymmdd)" android:textColor="@color/text_primary" />
            <RadioButton android:id="@+id/rbCustom" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="tag custom" android:textColor="@color/text_primary" />
        </RadioGroup>

        <EditText
            android:id="@+id/etCustomTag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="tag custom"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/cm_hint" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Catatan (opsional)"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/cm_hint" />

        <TextView
            android:id="@+id/tvPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="12dp"
            android:background="@drawable/card_neon"
            android:text="Pratinjau alias…"
            android:textColor="@color/neon_cyan"
            android:textSize="15sp" />

        <Button android:background="@drawable/btn_neon_primary" android:textColor="@color/cyber_bg" android:textStyle="bold"
            android:id="@+id/btnGenerate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Pratinjau" />

        <Button android:background="@drawable/btn_neon_primary" android:textColor="@color/cyber_bg" android:textStyle="bold"
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Simpan ke Bank" />
    </LinearLayout>
</ScrollView>
