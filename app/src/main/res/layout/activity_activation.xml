<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cyber_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aktivasi CloneMail"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="1 device = 1 lisensi. Kirim Device ID ke penjual, lalu masukkan kode aktivasi di bawah."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/rowDeviceId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@drawable/card_neon"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Device ID (tap untuk salin)"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvDeviceId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/neon_cyan"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textIsSelectable="true" />
        </LinearLayout>

        <EditText
            android:id="@+id/etLicenseCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Kode aktivasi (CM1-…)"
            android:inputType="text"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/cm_hint" />

        <TextView
            android:id="@+id/tvLicenseError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/cm_danger"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <Button android:background="@drawable/btn_neon_primary" android:textColor="@color/cyber_bg" android:textStyle="bold"
            android:id="@+id/btnActivate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Aktifkan"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="Tanpa kode valid, aplikasi tidak bisa dipakai."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="apk by DAFTECH"
            android:textColor="@color/cm_hint"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
